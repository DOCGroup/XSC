# -*- Makefile -*-
#----------------------------------------------------------------------------
#       GNU Makefile
#
# @file GNUmakefile.CIDL
#
# This file was automatically generated by MPC.  Any changes made directly to
# this file will be lost the next time it is generated.
#
#----------------------------------------------------------------------------
include $(CCF_ROOT)/Config.rules

MAKEFILE         = GNUmakefile.CIDL
DEPENDENCY_FILE  = .depend.CIDL

LIB_PREFIX      ?= lib
static_libs_only ?= 1

## LIB_CHECKED may be set to empty later on in this file
LIB_UNCHECKED    = $(LIB_PREFIX)CIDL.$(LIBEXT)
LIB_CHECKED      = $(LIB_UNCHECKED)
LIB_NAME         = $(LIB_PREFIX)CIDL
static_libs_only = 1

FILES = \
  ./SemanticAction/Composition.cpp \
  ./SemanticAction/Impl/Composition.cpp \
  ./SemanticAction/Impl/Factory.cpp \
  ./SemanticAction/Impl/HomeExecutor.cpp \
  ./SemanticGraph/Composition.cpp \
  ./SemanticGraph/Elements.cpp \
  ./SemanticGraph/Executor.cpp \
  ./Traversal/Executor.cpp \
  LexicalAnalyzer.cpp \
  Parser.cpp

VPATH = .:./Traversal:./SemanticAction:./SemanticGraph:./SemanticAction/Impl


LIBPATHS := . "$(BOOST_ROOT)/lib" "$(CCF_ROOT)/CCF"

#----------------------------------------------------------------------------
#       Include macros and targets
#----------------------------------------------------------------------------

PRJ_TYPE = library

COLLAPSE_SLASHES = $(if $(findstring //,$(1)),$(call COLLAPSE_SLASHES,$(subst //,/,$(1))),$(1))
INSLIB ?= $(call COLLAPSE_SLASHES,..)
ifeq ($(INSLIB),.)
  ifeq ($(CURDIR),)
    ifeq ($(PWD),)
      PWD=$(shell pwd)
    endif
  else
    PWD=$(CURDIR)
  endif
  INSLIB = $(PWD)
endif
OUTPUT_DIRECTORY = $(INSLIB)

include $(ACE_ROOT)/include/makeinclude/wrapper_macros.GNU


GNUACE_PROJECT_VERSION ?= $(ACE_VERSION)

# To build multiple targets in the same directory on AIX, it works
# best to have a template directory per project.
# The compiler/linker isn't too smart about instantiating templates...
ifdef TEMPINCDIR
TEMPINCDIR := $(TEMPINCDIR)/CIDL
all: $(TEMPINCDIR)
endif

ifneq ($(OUTPUT_DIRECTORY),)
.PHONY: create_output_directory.local
all: create_output_directory.local
create_output_directory.local:
	-@$(MKDIR) "$(OUTPUT_DIRECTORY)" $(ACE_NUL_STDERR)
endif

LIBCHECK = 1
ifeq ($(boost),1)
ifneq ($(cross_compile),1)
ifneq ($(LIBCHECK), 1)
  LIB_CHECKED   =
  all: lib_warning
endif
else
  LIB_CHECKED   =
  all: avoid_warning
endif
else
  LIB_CHECKED   =
  all: require_warning
endif

ifeq ($(boost),1)
ifneq ($(cross_compile),1)
else
  LIB_CHECKED   =
  all: avoid_warning
endif
else
  LIB_CHECKED   =
  all: require_warning
endif
LSRC   = $(FILES)

ifneq ($(CROSS-COMPILE),)
all clean realclean idl_stubs depend lib_warning require_warning avoid_warning install:
	@echo This project will not build on CROSS-COMPILE platforms.
else

include $(ACE_ROOT)/include/makeinclude/macros.GNU
include $(ACE_ROOT)/include/makeinclude/rules.common.GNU
include $(ACE_ROOT)/include/makeinclude/rules.nonested.GNU
include $(ACE_ROOT)/include/makeinclude/rules.lib.GNU
include $(ACE_ROOT)/include/makeinclude/rules.local.GNU
ifeq ($(VXWORKSLINK),1)
include $(TGT_DIR)/h/make/rules.$(PRJ_TYPE)
endif

ifeq ($(VXWORKSLINK),1)
LDLIBPATH     = -L. -L$(BOOST_ROOT)/lib -L$(CCF_ROOT)/CCF
else
LDFLAGS      += -L. $(if $(ARCH),-L./$(ARCH)) -L$(BOOST_ROOT)/lib $(if $(ARCH),-L$(BOOST_ROOT)/lib/$(ARCH)) -L$(CCF_ROOT)/CCF $(if $(ARCH),-L$(CCF_ROOT)/CCF/$(ARCH))
endif
CPPFLAGS     += -I$(BOOST_ROOT)/include/$(BOOST_VERSION) -I$(BOOST_ROOT)/. -I$(CCF_ROOT) -I$(CCF_ROOT)/CCF

#----------------------------------------------------------------------------
#       Local targets
#----------------------------------------------------------------------------
.PHONY: lib_warning
lib_warning:
	@echo CIDL will not be built due to the following missing library: $(LIBCHECK) >&2

ifneq ($(boost),1)
requires_disabled_macros += boost
endif
.PHONY: require_warning
require_warning:
	@echo CIDL will not be built due to the following disabled make macros: $(requires_disabled_macros)>&2

ifeq ($(cross_compile),1)
avoids_enabled_macros += cross_compile
endif
.PHONY: avoid_warning
avoid_warning:
	@echo CIDL will not be built due to the following enabled make macros: $(avoids_enabled_macros)>&2



realclean: clean
ifneq ($(GENERATED_DIRTY),)
	-$(RM) -r $(GENERATED_DIRTY)
endif

__prebuild__:
ifeq ($(boost),1)
ifneq ($(cross_compile),1)
	@-:
endif
endif


.PHONY: install
install: all
INSTALL_LIB ?= lib
ifneq ($(INSTALL_PREFIX),)
ifneq ($(install_rpath),0)
LD_RPATH ?= -Wl,-rpath,
LDFLAGS += $(LD_RPATH)$(INSTALL_PREFIX)/$(INSTALL_LIB) $(LD_RPATH_FLAGS)
endif
endif


endif # CROSS-COMPILE

