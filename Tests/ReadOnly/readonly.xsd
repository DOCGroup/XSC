<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:simpleType name="ReadOnlyKind">
    <xs:restriction base="xs:string">
      <xs:enumeration value="first"/>
      <xs:enumeration value="second"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="ReadOnlyKindWithOptionalAttribute">
    <xs:simpleContent>
      <xs:extension base="ReadOnlyKind">
        <xs:attribute name="label" type="xs:string"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="ReadOnlyType">
    <xs:sequence>
      <xs:element name="name" type="xs:string"/>
      <xs:element name="item" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="optionalValue" type="xs:string" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="requiredAttribute" type="xs:string" use="required"/>
    <xs:attribute name="optionalAttribute" type="xs:string"/>
  </xs:complexType>
</xs:schema>
