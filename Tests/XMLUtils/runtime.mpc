project (xsc_test_xml_utils_runtime): xscdefaults {
  requires += xsc
  custom_only = 1

  xscflags += --cxx-cpp17
  xscflags += --cxx-char-type char
  xscflags += --cxx-namespace-regex
  xscflags += "/.*xml-utils-test.*/XMLUtils/"

  XSC_Files {
    generated_types.xsd
  }

  Source_Files {
  }
}

project (xsc_test_xml_utils_runtime_generated): xscrt, ace_xml_utils {
  after += xsc_test_xml_utils_runtime

  Source_Files {
    runtime.cpp
    generated_types.cpp
  }
}

project (xsc_test_xml_utils_xscrt_registration): ace_xml_utils {
  Source_Files {
    xscrt_registration.cpp
  }
}
